{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node", "vitest/globals"],
    "paths": {
      "@wtv/protocol": ["../../packages/protocol/src/index.ts"]
    }
  },
  "include": ["src", "electron.vite.config.ts"],
  "exclude": ["**/._*", "**/node_modules", "out"]
}
